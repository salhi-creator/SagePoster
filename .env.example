# Shared keys for general post planning (or platform-key fallback).
GEMINI_API_KEY=
GROQ_API_KEY=

# Platform-specific keys take precedence for matching AI requests.
GEMINI_TELEGRAM_API_KEY=
GROQ_TELEGRAM_API_KEY=
GEMINI_DISCORD_API_KEY=
GROQ_DISCORD_API_KEY=
GEMINI_REDDIT_API_KEY=
GROQ_REDDIT_API_KEY=
GEMINI_LINKEDIN_API_KEY=
GROQ_LINKEDIN_API_KEY=

# Devvit service base URL (include any API prefix used by that project, if needed).
REDDIT_SERVICE_URL=
# Optional; used only if the Devvit service checks a bearer token.
REDDIT_SERVICE_TOKEN=

# Crosspost scheduled Reddit posts to these subreddits every 2 or 3 days.
# Comma-separated subreddit names, without the r/ prefix.
REDDIT_CROSSPOST_TARGETS=
REDDIT_CROSSPOST_SCAN_DAYS=3
